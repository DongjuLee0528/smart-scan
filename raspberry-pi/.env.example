# SmartScan Hub 라즈베리파이 환경변수
# .env.example 을 복사해서 .env 로 사용하세요
# cp .env.example .env

# API Gateway URL (변경하지 마세요)
API_GW_URL=https://f7o6rm5r6a.execute-api.ap-northeast-2.amazonaws.com/prod

# AP 설정
AP_SSID=SmartScan-Setup
AP_IP=192.168.4.1
PORTAL_PORT=80

# 스캔 설정
SCAN_WINDOW_SEC=3        # 빠른 통과 감지: 3.0 권장 (데모용 1.5 → 복원)

# RFID 출력 파워 (hex, 00=-2dBm ~ 1B=25dBm)
# 실내 1-3m: 14 (18dBm) 권장 — 최대출력(1B)은 다중경로 간섭으로 오히려 불안정
# 미설정 시 리더기 기본값 유지
RFID_POWER=14

# WAITING_CLEAR 최대 대기 (초) — 태그 소멸 확인 후 IDLE 복귀
CLEAR_WAIT_SEC=45        # 데모용 20 → 45초로 완화

# Mock 모드 (실기기 없이 테스트할 때 true)
MOCK_MODE=false

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxx...

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
DB_HOST=db.xxx.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-password
DB_NAME=postgres

# JWT
JWT_SECRET_KEY=your-secret-key
JWT_ALGORITHM=HS256

# SMTP (Resend)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=re_xxx
SMTP_FROM_EMAIL=noreply@smartscan-hub.com

# Resend
RESEND_API_KEY=re_xxx

# CORS
ALLOWED_ORIGIN=http://localhost:3000

# Firebase Admin SDK (푸시 알림)
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"smart-scan-xxx","private_key_id":"xxx","private_key":"-----BEGIN PRIVATE KEY-----\nxxx\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@smart-scan-xxx.iam.gserviceaccount.com","client_id":"xxx","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxx%40smart-scan-xxx.iam.gserviceaccount.com"}

# Environment
ENV=development
